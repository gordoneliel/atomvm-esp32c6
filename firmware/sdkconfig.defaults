CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Paths are relative to the AtomVM ESP32 project (AtomVM/src/platforms/esp32)
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../firmware/partitions.csv"
CONFIG_APP_REPRODUCIBLE_BUILD=y

# Console over USB-Serial/JTAG (XIAO ESP32-C6 has no UART bridge)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Thread-only device (disable WiFi for Matter commissioning)
CONFIG_ENABLE_WIFI_STATION=n

# BLE (NimBLE for Matter commissioning)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# As esp-matter's examples: no automatic reconnection attempts
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# IPv6 (required for Thread/Matter). OpenThread assigns the Thread
# interface's addresses itself, so lwIP's autoconfiguration stays off, and
# the interface needs room for them all: link-local, mesh-local, RLOC, the
# border router's routable (OMR) address and more
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=n
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y

# OpenThread (FTD — can route for other devices in the mesh)
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y

# Matter / CHIP
CONFIG_ESP_MATTER_ENABLE_DATA_MODEL=y
CONFIG_CHIP_TASK_STACK_SIZE=8192
CONFIG_ENABLE_CHIP_SHELL=n
# Matter over Thread advertises its services by registering them with the
# border router (SRP, through OpenThread). Minimal mDNS only multicasts on
# the local link, which controllers can't see across a border router.
CONFIG_USE_MINIMAL_MDNS=n
# Test vendor/product IDs (replace for production); setup PIN 20202021 and
# discriminator 0xF00 are the CHIP test defaults
CONFIG_DEVICE_VENDOR_ID=0xFFF1
CONFIG_DEVICE_PRODUCT_ID=0x8001
CONFIG_BLE_DEVICE_NAME_PREFIX="Firefly"
# Vendor and product names come from the app's config, through a provider
# registered by the Matter component (atomvm_matter.cpp)
CONFIG_CUSTOM_DEVICE_INSTANCE_INFO_PROVIDER=y
# Keep BLE up while the commissioner establishes CASE over Thread
CONFIG_ENABLE_CONCURRENT_CONNECTION=y

# Crypto (Matter requires)
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y

# Optimize for size: the Matter SDK nearly fills the 3.3MB app partition
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
